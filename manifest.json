{
  "manifest_version": 3,
  "name": "GTyipe",
  "version": "2.0.0",
  "description": "Ask Gemini side panel and in-document assistant for Google Docs with autonomous real-time typing into your document.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "GTyipe for Google Docs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "css": [
        "src/content/in_page_agent.css"
      ],
      "js": [
        "src/content/auto_typer.js",
        "src/content/docs_observer.js",
        "src/content/docs_bridge.js",
        "src/content/in_page_agent.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
